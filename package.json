{
  "name": "reuse-app",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --offline",
    "android": "expo start --android --offline",
    "ios": "expo start --ios --offline",
    "doctor": "expo-doctor",
    "deploy": "expo export -p web && wrangler pages deploy dist --project-name reuse-fiapweb2 --branch master",
    "preview": "expo export -p web && wrangler pages dev dist",
    "api:dev": "wrangler dev -c api/wrangler.jsonc --env dev --ip 0.0.0.0 --port 8787",
    "api:migrar:local": "wrangler d1 migrations apply reuse-db --local -c api/wrangler.jsonc --env dev",
    "api:migrar": "wrangler d1 migrations apply reuse-db --remote -c api/wrangler.jsonc",
    "api:deploy": "wrangler deploy -c api/wrangler.jsonc"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "53.0.11",
    "expo-asset": "~11.1.7",
    "expo-font": "~13.3.2",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.5",
    "expo-location": "~18.1.5",
    "expo-secure-store": "~14.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.88.0",
    "react-native": "0.79.3",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3",
    "wrangler": "^4.135.0"
  }
}
